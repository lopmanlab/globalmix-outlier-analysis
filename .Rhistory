ind = rasterGrob(readPNG(paste0("figs/histograms/", "ind_touch_hist.png")), interpolate = TRUE)
pak = rasterGrob(readPNG(paste0("figs/histograms/", "pak_touch_hist.png")), interpolate = TRUE)
