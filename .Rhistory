}
reference =  c(rep("Age\nRef: 30-39y", 8),
"Sex\nRef: Female",
"Site\nRef: Rural",
rep("Household Size\nRef: 0-2 members", 2),
rep("Occupation\nRef: Unemployed, Child, Other", 3))
term <- c("<6mo", "6-11mo", "1-4y", "5-9y", "10-19y", "20-29y", "40-59y", "60+y",
"Male",
"Urban",
"3-5", "6+", #"8+",
"Student", "Laborer", "Professional")
